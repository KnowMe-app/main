        ".write": "auth != null && (data.exists() ? data.child('authorId').val() === auth.uid : newData.child('authorId').val() === auth.uid)",
        ".validate": "!newData.exists() || newData.hasChildren(['text', 'authorId', 'createdAt'])",
        "text": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 2000"
        },
        "authorId": {
          ".validate": "newData.isString() && newData.val() === auth.uid && (!data.exists() || data.val() === newData.val())"
        },
        "authorName": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || data.val() === newData.val())"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() || !newData.exists()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
